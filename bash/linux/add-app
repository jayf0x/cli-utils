#!/bin/bash
# add-app — install or uninstall a .AppImage or .deb as a proper Linux app
#
# Usage:
#   add-app ./SomeApp.AppImage [--no-pin] [--name "Custom Name"]
#   add-app ./some-package.deb [--no-pin]
#   add-app --uninstall <name-or-desktop-id> [-y]
#
# What it does for .AppImage:
#   - chmod +x, moves it into ~/Applications
#   - extracts the embedded .desktop file + icon
#   - installs the icon into ~/.local/share/icons/hicolor
#   - writes a launcher to ~/.local/share/applications
#   - pins it to the GNOME dock (unless --no-pin)
#
# What it does for .deb:
#   - installs it via apt (resolves dependencies)
#   - finds the .desktop file the package registered
#   - pins it to the GNOME dock (unless --no-pin)
#
# --uninstall matches by app name or .desktop filename (substring, case
# insensitive) across both ~/.local/share/applications and
# /usr/share/applications. For apps we installed from an AppImage it removes
# the launcher, icon, and the AppImage itself from ~/Applications. For apps
# installed system-wide (e.g. via .deb) it removes the launcher's owning
# package with apt. Either way it also unpins it from the dock. Ambiguous
# matches are listed instead of guessed.
#
# If the AppImage doesn't bundle a usable .desktop/icon and the `claude`
# CLI is available on PATH, falls back to asking Claude Code to generate
# a .desktop entry from the extracted file listing. Best-effort only.

set -uo pipefail

APPS_DIR="$HOME/Applications"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
ICON_DIR_SVG="$HOME/.local/share/icons/hicolor/scalable/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

no_pin=false
custom_name=""
input=""
uninstall_query=""
assume_yes=false

usage() {
  sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-pin) no_pin=true; shift ;;
    --name) custom_name="$2"; shift 2 ;;
    --uninstall|-u) uninstall_query="$2"; shift 2 ;;
    -y|--yes) assume_yes=true; shift ;;
    -h|--help) usage ;;
    *) input="$1"; shift ;;
  esac
done

if [ -n "$uninstall_query" ]; then
  : # handled below, after function defs
elif [ -z "$input" ]; then
  usage
else
  [ -f "$input" ] || { echo "add-app: no such file: $input" >&2; exit 1; }
fi

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//'
}

pin_to_dock() {
  local desktop_id="$1"

  if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]] || ! command -v gsettings &> /dev/null; then
    echo "add-app: not GNOME (or gsettings missing) — skipping dock pin. Pin '$desktop_id' manually if you want it in the dock."
    return
  fi

  local current
  current=$(gsettings get org.gnome.shell favorite-apps)

  python3 - "$current" "$desktop_id" <<'EOF'
import ast, subprocess, sys

current = ast.literal_eval(sys.argv[1])
app_id = sys.argv[2]

if app_id in current:
    sys.exit(0)

current.append(app_id)
subprocess.run(["gsettings", "set", "org.gnome.shell", "favorite-apps", repr(current)])
EOF

  echo "add-app: pinned '$desktop_id' to the dock"
}

unpin_from_dock() {
  local desktop_id="$1"

  if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]] || ! command -v gsettings &> /dev/null; then
    return
  fi

  local current
  current=$(gsettings get org.gnome.shell favorite-apps)

  python3 - "$current" "$desktop_id" <<'EOF'
import ast, subprocess, sys

current = ast.literal_eval(sys.argv[1])
app_id = sys.argv[2]

if app_id not in current:
    sys.exit(0)

current = [a for a in current if a != app_id]
subprocess.run(["gsettings", "set", "org.gnome.shell", "favorite-apps", repr(current)])
EOF
}

ai_resolve_desktop() {
  local squashfs_dir="$1" exec_path="$2" out_desktop="$3"

  command -v claude &> /dev/null || return 1

  echo "add-app: no bundled .desktop/icon found, asking claude to figure it out..." >&2

  local listing
  listing=$(find "$squashfs_dir" -maxdepth 3 2>/dev/null)

  local prompt="An AppImage was extracted to a squashfs-root directory. Here is the file
listing (truncated to depth 3):

$listing

Write a valid freedesktop .desktop file for this app. Use Exec=$exec_path
(do not change this path), pick a sensible Name/Comment/Categories from the
file listing, set Terminal=false and Type=Application. On the Icon= line put
just an icon name (no path) — pick a plausible one from the listing if a png
or svg is visible, otherwise use 'application-x-executable'.

Output ONLY the raw .desktop file contents, nothing else."

  claude -p "$prompt" > "$out_desktop" 2> /dev/null

  [ -s "$out_desktop" ] && grep -q "^\[Desktop Entry\]" "$out_desktop"
}

install_appimage() {
  local src abs_path dest tmpdir squashfs desktop_src
  src="$input"
  abs_path=$(readlink -f "$src")

  chmod +x "$abs_path"
  mkdir -p "$APPS_DIR"

  dest="$APPS_DIR/$(basename "$abs_path")"
  if [ "$abs_path" != "$dest" ]; then
    mv "$abs_path" "$dest"
  fi

  tmpdir=$(mktemp -d)
  ( cd "$tmpdir" && "$dest" --appimage-extract > /dev/null 2>&1 )
  squashfs="$tmpdir/squashfs-root"

  if [ ! -d "$squashfs" ]; then
    echo "add-app: failed to extract AppImage (does it support --appimage-extract?)" >&2
    rm -rf "$tmpdir"
    exit 1
  fi

  desktop_src=$(find "$squashfs" -maxdepth 2 -iname "*.desktop" | head -n1)

  local name comment categories icon_name
  if [ -n "$desktop_src" ]; then
    name=$(grep -m1 '^Name=' "$desktop_src" | cut -d= -f2-)
    comment=$(grep -m1 '^Comment=' "$desktop_src" | cut -d= -f2-)
    categories=$(grep -m1 '^Categories=' "$desktop_src" | cut -d= -f2-)
    icon_name=$(grep -m1 '^Icon=' "$desktop_src" | cut -d= -f2-)
  fi

  [ -n "$custom_name" ] && name="$custom_name"
  name="${name:-$(basename "$dest" .AppImage)}"
  comment="${comment:-Installed via add-app}"
  categories="${categories:-Utility;}"

  local app_id icon_src icon_ext
  app_id=$(slugify "$name")

  if [ -n "${icon_name:-}" ]; then
    icon_src=$(find "$squashfs" -iname "${icon_name}.png" -o -iname "${icon_name}.svg" 2>/dev/null | head -n1)
  fi
  [ -z "${icon_src:-}" ] && icon_src=$(find "$squashfs" -maxdepth 1 -iname "*.png" -o -maxdepth 1 -iname "*.svg" 2>/dev/null | head -n1)
  [ -z "${icon_src:-}" ] && [ -f "$squashfs/.DirIcon" ] && icon_src="$squashfs/.DirIcon"

  local icon_field="application-x-executable"
  if [ -n "${icon_src:-}" ]; then
    icon_ext="${icon_src##*.}"
    if [ "$icon_ext" = "svg" ]; then
      mkdir -p "$ICON_DIR_SVG"
      cp "$icon_src" "$ICON_DIR_SVG/$app_id.svg"
    else
      mkdir -p "$ICON_DIR"
      cp "$icon_src" "$ICON_DIR/$app_id.png"
    fi
    icon_field="$app_id"
  fi

  mkdir -p "$DESKTOP_DIR"
  local out_desktop="$DESKTOP_DIR/$app_id.desktop"

  if [ -z "$desktop_src" ] && ! ai_resolve_desktop "$squashfs" "$dest" "$out_desktop"; then
    cat > "$out_desktop" <<EOF
[Desktop Entry]
Name=$name
Comment=$comment
Exec=$dest
Icon=$icon_field
Categories=$categories
Terminal=false
Type=Application
EOF
  elif [ ! -f "$out_desktop" ] || ! grep -q "^\[Desktop Entry\]" "$out_desktop" 2>/dev/null; then
    cat > "$out_desktop" <<EOF
[Desktop Entry]
Name=$name
Comment=$comment
Exec=$dest
Icon=$icon_field
Categories=$categories
Terminal=false
Type=Application
EOF
  fi

  # Force Exec/Icon to correct values even if AI or bundled file guessed wrong
  sed -i "s|^Exec=.*|Exec=$dest|" "$out_desktop"
  grep -q '^Icon=' "$out_desktop" && sed -i "s|^Icon=.*|Icon=$icon_field|" "$out_desktop" || echo "Icon=$icon_field" >> "$out_desktop"

  chmod +x "$out_desktop"

  update-desktop-database "$DESKTOP_DIR" 2> /dev/null
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" 2> /dev/null

  rm -rf "$tmpdir"

  echo "add-app: installed '$name' -> $dest"
  echo "add-app: launcher -> $out_desktop"

  [ "$no_pin" = false ] && pin_to_dock "$app_id.desktop"
}

install_deb() {
  local pkg_name desktop_path desktop_id

  pkg_name=$(dpkg-deb -f "$input" Package 2>/dev/null)
  if [ -z "$pkg_name" ]; then
    echo "add-app: could not read package name from $input" >&2
    exit 1
  fi

  echo "add-app: installing $pkg_name via apt (may prompt for sudo password)..."
  sudo apt install -y "$(readlink -f "$input")"

  desktop_path=$(dpkg -L "$pkg_name" 2>/dev/null | grep -m1 '\.desktop$')
  if [ -z "$desktop_path" ]; then
    echo "add-app: installed, but couldn't find a .desktop file for '$pkg_name' — pin it manually."
    exit 0
  fi

  desktop_id=$(basename "$desktop_path")
  echo "add-app: installed '$pkg_name', launcher -> $desktop_path"

  [ "$no_pin" = false ] && pin_to_dock "$desktop_id"
}

find_desktop_candidates() {
  local query="${1,,}"
  local f base name

  for f in "$DESKTOP_DIR"/*.desktop /usr/share/applications/*.desktop; do
    [ -f "$f" ] || continue
    base=$(basename "$f" .desktop)
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    if [[ "${base,,}" == *"$query"* ]] || [[ "${name,,}" == *"$query"* ]]; then
      echo "$f"
    fi
  done
}

uninstall_app() {
  local query="$1"
  local candidates count desktop_path desktop_id name

  candidates=$(find_desktop_candidates "$query" | sort -u)
  count=$([ -z "$candidates" ] && echo 0 || echo "$candidates" | wc -l)

  if [ "$count" -eq 0 ]; then
    echo "add-app: no installed app matching '$query'" >&2
    exit 1
  fi

  if [ "$count" -gt 1 ]; then
    echo "add-app: multiple matches for '$query', be more specific:" >&2
    while IFS= read -r c; do
      echo "  $(basename "$c" .desktop)  ($c)" >&2
    done <<< "$candidates"
    exit 1
  fi

  desktop_path="$candidates"
  desktop_id=$(basename "$desktop_path")
  name=$(grep -m1 '^Name=' "$desktop_path" | cut -d= -f2-)
  name="${name:-$desktop_id}"

  if [ "$assume_yes" = false ]; then
    read -p "add-app: remove '$name' ($desktop_path)? [y/N]: " confirm
    [[ "$confirm" == [Yy]* ]] || { echo "add-app: aborted"; exit 0; }
  fi

  unpin_from_dock "$desktop_id"

  if [[ "$desktop_path" == "$DESKTOP_DIR"/* ]]; then
    # user-local launcher -> installed by us from an AppImage (or manually)
    local exec_line exec_path icon_name
    exec_line=$(grep -m1 '^Exec=' "$desktop_path" | cut -d= -f2-)
    exec_path=$(echo "$exec_line" | awk '{print $1}' | tr -d '"')
    icon_name=$(grep -m1 '^Icon=' "$desktop_path" | cut -d= -f2-)

    rm -f "$desktop_path"
    [ -n "$icon_name" ] && rm -f "$ICON_DIR/$icon_name.png" "$ICON_DIR_SVG/$icon_name.svg"

    if [ -n "$exec_path" ] && [[ "$exec_path" == "$APPS_DIR"/* ]] && [ -f "$exec_path" ]; then
      rm -f "$exec_path"
      echo "add-app: removed '$name', launcher, icon, and $exec_path"
    else
      echo "add-app: removed '$name' launcher and icon (executable at '$exec_path' left in place)"
    fi
  else
    # system-wide launcher -> likely owned by a dpkg package
    local pkg
    pkg=$(dpkg -S "$desktop_path" 2>/dev/null | cut -d: -f1 | head -n1)

    if [ -n "$pkg" ]; then
      echo "add-app: removing package '$pkg' via apt (may prompt for sudo password)..."
      sudo apt remove -y "$pkg"
    else
      echo "add-app: '$desktop_path' isn't owned by an apt package — remove it manually if desired."
    fi
  fi

  update-desktop-database "$DESKTOP_DIR" 2> /dev/null
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" 2> /dev/null
}

if [ -n "$uninstall_query" ]; then
  uninstall_app "$uninstall_query"
  exit 0
fi

case "${input,,}" in
  *.appimage) install_appimage ;;
  *.deb) install_deb ;;
  *) echo "add-app: unsupported file type: $input (expected .AppImage or .deb)" >&2; exit 1 ;;
esac
